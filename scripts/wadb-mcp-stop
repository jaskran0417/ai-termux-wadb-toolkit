#!/data/data/com.termux/files/usr/bin/bash
source /data/data/com.termux/files/usr/libexec/ai-wadb/mcp-recovery-common
set_mcp_desired offline
if [ "${1:-}" = "--now" ]; then
  stop_now manual
  write_status
else
  nohup /data/data/com.termux/files/usr/bin/bash -c '
    sleep 2
    source /data/data/com.termux/files/usr/libexec/ai-wadb/mcp-recovery-common
    stop_now manual
    write_status
  ' >> "$LOGDIR/stop.log" 2>&1 < /dev/null &
  echo "Desktop Commander stop scheduled. Saved sign-in is preserved; recovery configuration is unchanged."
fi
