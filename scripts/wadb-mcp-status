#!/data/data/com.termux/files/usr/bin/bash
source /data/data/com.termux/files/usr/libexec/ai-wadb/mcp-recovery-common
write_status
if [ "${1:-}" = "--json" ]; then
  python - "$STATE/status" <<'PY'
import json,sys
out={}
for line in open(sys.argv[1],encoding="utf-8"):
    if "=" in line:
        k,v=line.rstrip("\n").split("=",1)
        out[k]=v
print(json.dumps(out,indent=2))
PY
else
  cat "$STATE/status"
fi
