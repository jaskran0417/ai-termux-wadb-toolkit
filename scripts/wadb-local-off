#!/data/data/com.termux/files/usr/bin/bash
set -u
TERMUX_HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
PATH="$PREFIX/bin:/system/bin:$PATH"
export PATH

TERMUX_TOKEN_FILE="$TERMUX_HOME/.ai-wadb/local-bridge.token"
ANDROID_TOKEN_FILE="$TERMUX_HOME/.ai-wadb/local-android-shell.token"
MODE=human
CONFIRM=0
TARGET=termux
for arg in "$@"; do
  case "$arg" in
    --confirm) CONFIRM=1 ;;
    --machine) MODE=machine ;;
    --android|--adb) TARGET=android ;;
    --termux) TARGET=termux ;;
    --all) TARGET=all ;;
    --help|-h)
      cat <<'EOF'
Usage:
  wadb-local-off --confirm                  Stop only Local Termux Shell (UID 10572).
  wadb-local-off --android --confirm        Stop only Local Android Shell (UID 2000).
  wadb-local-off --all --confirm            Stop both local shell services.

Stopping either bridge does not change Wireless Debugging, USB debugging, MCP, or saved ADB trust.
EOF
      exit 0
      ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done
[ "$CONFIRM" -eq 1 ] || { echo "No action taken. Explicit confirmation is required: wadb-local-off --confirm"; exit 2; }

stop_termux() {
  if [ ! -s "$TERMUX_TOKEN_FILE" ] || ! timeout 4 wadb-local-shell --termux --ping >/dev/null 2>&1; then
    rm -f "$TERMUX_TOKEN_FILE"
    echo "LOCAL_TERMUX_SHELL=not_running"
    return 0
  fi
  wadb-local-shell --termux --stop || return 20
  sleep 1
  if timeout 3 wadb-local-shell --termux --ping >/dev/null 2>&1; then return 21; fi
  rm -f "$TERMUX_TOKEN_FILE"
  echo "LOCAL_TERMUX_SHELL=stopped"
}

stop_android() {
  if [ ! -s "$ANDROID_TOKEN_FILE" ] || ! timeout 4 wadb-local-shell --android --ping >/dev/null 2>&1; then
    rm -f "$ANDROID_TOKEN_FILE"
    echo "LOCAL_ANDROID_ADB_SHELL=not_running"
    return 0
  fi
  uid="$(timeout 4 wadb-local-shell --android --ping 2>/dev/null | sed -n 's/^WADB_SECURE_BRIDGE_OK uid=\([0-9][0-9]*\).*/\1/p' | head -n1)"
  [ "$uid" = "2000" ] || { echo "LOCAL_ANDROID_ADB_SHELL=wrong_identity"; return 22; }
  wadb-local-shell --android --stop || return 23
  sleep 1
  if timeout 3 wadb-local-shell --android --ping >/dev/null 2>&1; then return 24; fi
  rm -f "$ANDROID_TOKEN_FILE"
  echo "LOCAL_ANDROID_ADB_SHELL=stopped"
}

rc=0
case "$TARGET" in
  termux) stop_termux || rc=$? ;;
  android) stop_android || rc=$? ;;
  all)
    stop_termux || rc=$?
    stop_android || rc=$?
    ;;
esac

if [ "$MODE" = machine ]; then
  [ "$rc" -eq 0 ] && echo "RESULT=LOCAL_SHELL_STOPPED" || echo "RESULT=LOCAL_SHELL_STOP_FAILED"
  exit "$rc"
fi
if [ "$rc" -eq 0 ]; then
  echo "Local shell stop request completed and was verified."
  echo "Wireless Debugging, USB debugging, ADB trust and Desktop Commander MCP were not changed."
else
  echo "Local shell stop failed verification (exit $rc)."
fi
exit "$rc"
