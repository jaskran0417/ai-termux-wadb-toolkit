#!/data/data/com.termux/files/usr/bin/bash
set -u
TERMUX_HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
STATE="$TERMUX_HOME/.ai-wadb/mcp-recovery"
PROP="$TERMUX_HOME/.termux/termux.properties"
PREV_PROP="$STATE/allow-external-apps.previous.json"
KEEP_EXTERNAL=0
OUTPUT_MODE=human

for arg in "$@"; do
  case "$arg" in
    --keep-external-apps) KEEP_EXTERNAL=1 ;;
    --machine) OUTPUT_MODE=machine ;;
    -h|--help) echo "Usage: wadb-mcp-recovery-disable [--keep-external-apps] [--machine]"; echo "Disables the watchdog and cancels the Android Bridge one-shot alarm; MCP remains online."; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done


source "$PREFIX/libexec/ai-wadb/mcp-recovery-common"
set_recovery_enabled 0
if bridge_recovery_alarm disable; then ALARM_CANCELLED=1; else ALARM_CANCELLED=0; fi

p="$(cat "$STATE/watchdog.pid" 2>/dev/null || true)"
[ -n "$p" ] && kill "$p" 2>/dev/null || true
sleep 1
[ -n "$p" ] && kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null || true
rm -f "$STATE/watchdog.pid"
rm -rf "$STATE/watchdog.lockdir"
notify_event RECOVERY_DISABLED
write_status

if [ "$KEEP_EXTERNAL" -eq 0 ] && [ -r "$PREV_PROP" ]; then
  python - "$PROP" "$PREV_PROP" <<'PYPROP'
import json,re,sys
from pathlib import Path
prop=Path(sys.argv[1]); prev=Path(sys.argv[2])
data=json.loads(prev.read_text())
original=data.get("original_line")
lines=prop.read_text(errors="ignore").splitlines() if prop.exists() else []
rx=re.compile(r'^\s*(#\s*)?allow-external-apps\s*=')
lines=[line for line in lines if not rx.match(line)]
if original is not None:
    if lines and lines[-1] != "":
        lines.append("")
    lines.append(original)
prop.parent.mkdir(parents=True,exist_ok=True)
prop.write_text("\n".join(lines)+("\n" if lines else ""))
PYPROP
  rm -f "$PREV_PROP"
  termux-reload-settings >/dev/null 2>&1 || true
  external_state=restored
else
  external_state=unchanged
fi
if [ "$OUTPUT_MODE" = machine ]; then
  echo "RECOVERY=disabled"
  if [ "$ALARM_CANCELLED" -eq 1 ]; then echo "BRIDGE_ALARM=cancelled"; else echo "BRIDGE_ALARM=cancel_unconfirmed"; fi
  echo "ALLOW_EXTERNAL_APPS=$external_state"
else
  echo "Desktop Commander automatic recovery: Disabled."
  [ "$external_state" = restored ] && echo "- Termux external-command setting: Restored to its previous value." || echo "- Termux external-command setting: Left unchanged."
  echo "- Running Desktop Commander process: Not stopped."
  echo "- Saved Desktop Commander sign-in: Preserved."
  if [ "$ALARM_CANCELLED" -eq 1 ]; then echo "- Android Bridge recovery alarm: Cancelled."; else echo "- Android Bridge recovery alarm: Cancellation was not confirmed; a remaining one-shot can only run the disabled-state check."; fi
fi
