  get_state
  export VERSION DEVICE_MFR DEVICE_MODEL ANDROID
  export MCP_STATE MCP_CREDS MCP_OWNER MCP_PID MCP_HOME_DETECTED MCP_DESIRED MCP_ACTUAL MCP_PROCESS_COUNT
  export RECOVERY_ENABLED WATCHDOG WATCHDOG_INTERVAL_DISPLAY NOTIFICATIONS_ENABLED_DISPLAY
