#!/data/data/com.termux/files/usr/bin/sh
export PATH=/system/bin:/data/data/com.termux/files/usr/bin:$PATH

run_get() {
  /system/bin/am broadcast --user 0 --include-stopped-packages     -a com.jaskran.wadbbridge.GET_WIRELESS_DEBUG     -n com.jaskran.wadbbridge/.WirelessDebugReceiver </dev/null 2>&1
}

out=""
i=1
while [ $i -le 3 ]; do
  out="$(run_get)"
  rc=$?
  printf '%s
' "$out"
  if [ $rc -eq 0 ] &&
     printf '%s
' "$out" | grep -q 'Broadcast completed: result=-1' &&
     ! printf '%s
' "$out" | grep -q 'Failure calling service'; then
    break
  fi
  [ $i -lt 3 ] && sleep 1
  i=$((i+1))
done

val="$(printf '%s
' "$out" | sed -n 's/.*data="adb_wifi_enabled=\([0-9-]*\)".*/\1/p' | tail -n1)"
case "$val" in
  0|1) ;;
  *)
    echo "bridge_status=unavailable"
    echo "bridge_write=unknown"
    printf 'adbd='
    /system/bin/getprop init.svc.adbd 2>/dev/null
    exit 1
    ;;
esac

# Verify write capability without changing the current setting.
enabled=false
[ "$val" = 1 ] && enabled=true
setout=$(/system/bin/am broadcast --user 0 --include-stopped-packages   -a com.jaskran.wadbbridge.SET_WIRELESS_DEBUG   -n com.jaskran.wadbbridge/.WirelessDebugReceiver   --ez enabled "$enabled" </dev/null 2>&1)
setrc=$?

if [ $setrc -eq 0 ] &&
   printf '%s
' "$setout" | grep -q 'Broadcast completed: result=-1' &&
   printf '%s
' "$setout" | grep -Fq "data=\"adb_wifi_enabled=$val; write=true\"" &&
   ! printf '%s
' "$setout" | grep -q 'SecurityException'; then
  echo "bridge_write=ready"
else
  echo "bridge_write=denied"
fi

printf 'adbd='
/system/bin/getprop init.svc.adbd 2>/dev/null
