#!/data/data/com.termux/files/usr/bin/bash
set -u

TERMUX_HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
PATH="$PREFIX/bin:/system/bin:$PATH"
export PATH

MODE=human
case "${1:-}" in
  --machine) MODE=machine ;;
  --help|-h)
    printf '%s\\n' "Usage: wadb-local-status [--machine]"
    printf '%s\\n' "Reads the independent authenticated loopback Local Termux Shell status."
    exit 0
    ;;
  "") ;;
  *) printf 'Unknown option: %s\\n' "$1" >&2; exit 2 ;;
esac
PORT="${WADB_LOCAL_BRIDGE_PORT:-47173}"
ENDPOINT="127.0.0.1:$PORT"
TOKEN_FILE="$TERMUX_HOME/.ai-wadb/local-bridge.token"
TERMUX_UID="$(id -u 2>/dev/null || echo unknown)"

LOCAL_ADB_STATE="not_connected"
LOCAL_ADB_MODE="termux_loopback_shell"
LOCAL_ADB_ENDPOINT="$ENDPOINT"
LOCAL_ADB_SERIAL=""
LOCAL_ADB_PORT="$PORT"
LOCAL_ADB_SHELL_UID=""
LOCAL_ADB_RUNTIME_UID=""
PROTOCOL="authenticated_termux_loopback_v1"
BRIDGE_AUTH="token"
LISTENER_SCOPE="not_listening"

ADBD_STATE="$(getprop init.svc.adbd 2>/dev/null || true)"
TCP_PORT="$(getprop service.adb.tcp.port 2>/dev/null || true)"
LISTEN_ADDRS="$(getprop service.adb.listen_addrs 2>/dev/null || true)"
USB_CONFIG="$(getprop sys.usb.config 2>/dev/null || true)"
USB_STATE="$(getprop sys.usb.state 2>/dev/null || true)"
ADB_SECURE="$(getprop ro.adb.secure 2>/dev/null || true)"
ADB_ENABLED="not_required"
ADB_WIFI_ENABLED="unknown"
ADBD_TCP_EXPOSURE="unknown"
WIFI_STATE="$(dumpsys wifi 2>/dev/null | grep -m1 -E 'Wi-Fi is (enabled|disabled)' || true)"

if command -v wadb-local-shell >/dev/null 2>&1 && [ -s "$TOKEN_FILE" ]; then
  ping="$(timeout 4 wadb-local-shell --ping 2>/dev/null || true)"
  runtime_uid="$(printf '%s\n' "$ping" | sed -n 's/^WADB_SECURE_BRIDGE_OK uid=\([0-9][0-9]*\).*/\1/p' | head -n1)"
  if [ -n "$runtime_uid" ]; then
    LOCAL_ADB_RUNTIME_UID="$runtime_uid"
    LOCAL_ADB_SHELL_UID=""
    if [ "$runtime_uid" = "$TERMUX_UID" ]; then
      LOCAL_ADB_STATE="ready"
      LISTENER_SCOPE="loopback_only"
    else
      LOCAL_ADB_STATE="legacy_runtime"
      LISTENER_SCOPE="loopback_only"
    fi
  fi
fi

if [ -n "$LISTEN_ADDRS" ]; then
  case "$LISTEN_ADDRS" in
    tcp:localhost:*|tcp:127.0.0.1:*|tcp:\[::1\]:*) ADBD_TCP_EXPOSURE="loopback_only" ;;
    *) ADBD_TCP_EXPOSURE="custom_or_wide" ;;
  esac
else
  case "$TCP_PORT" in
    ''|0|-1) ADBD_TCP_EXPOSURE="none" ;;
    *[!0-9]*) ADBD_TCP_EXPOSURE="unknown" ;;
    *) ADBD_TCP_EXPOSURE="all_interfaces" ;;
  esac
fi

if command -v wireless-debug-status >/dev/null 2>&1; then
  wd="$(timeout 4 wireless-debug-status --machine 2>&1 || true)"
  val="$(printf '%s\n' "$wd" | sed -n 's/.*adb_wifi_enabled=\([0-9-]*\).*/\1/p' | tail -n1)"
  [ -n "$val" ] && ADB_WIFI_ENABLED="$val"
  adbd="$(printf '%s\n' "$wd" | sed -n 's/^adbd=//p' | tail -n1)"
  [ -n "$adbd" ] && ADBD_STATE="$adbd"
fi

SECURITY_STATE=not_running
SECURITY_WARNING=""
if [ "$LOCAL_ADB_STATE" = "ready" ]; then
  if [ "$ADBD_TCP_EXPOSURE" = "none" ]; then SECURITY_STATE=termux_loopback_shell_no_adb_dependency
  else SECURITY_STATE=termux_loopback_shell_adbd_tcp_attention; SECURITY_WARNING=adbd_tcp_listener_is_separate_from_the_loopback_shell
  fi
elif [ "$LOCAL_ADB_STATE" = "legacy_runtime" ]; then
  SECURITY_STATE=legacy_android_shell_uid_bridge
  SECURITY_WARNING=run_wadb-local-on_to_replace_with_lower_privilege_termux_uid_bridge
fi
if [ "$MODE" = machine ]; then
  printf '%s\n' "LOCAL_ADB_STATE=$LOCAL_ADB_STATE" "LOCAL_ADB_MODE=$LOCAL_ADB_MODE" "LOCAL_ADB_ENDPOINT=$LOCAL_ADB_ENDPOINT" "LOCAL_ADB_SERIAL=$LOCAL_ADB_SERIAL" "LOCAL_ADB_PORT=$LOCAL_ADB_PORT" "LOCAL_ADB_SHELL_UID=$LOCAL_ADB_SHELL_UID" "LOCAL_ADB_RUNTIME_UID=$LOCAL_ADB_RUNTIME_UID" "USB_DEBUGGING_REQUIRED=no" "WIRELESS_DEBUGGING_REQUIRED=no" "WIFI_REQUIRED=no" "ADBD_REQUIRED=no" "PROTOCOL=$PROTOCOL" "BRIDGE_AUTH=$BRIDGE_AUTH" "LISTENER_SCOPE=$LISTENER_SCOPE" "ADB_ENABLED=$ADB_ENABLED" "ADB_WIFI_ENABLED=$ADB_WIFI_ENABLED" "ADBD_STATE=$ADBD_STATE" "TCP_PORT=$TCP_PORT" "LISTEN_ADDRS=$LISTEN_ADDRS" "ADBD_TCP_EXPOSURE=$ADBD_TCP_EXPOSURE" "USB_CONFIG=$USB_CONFIG" "USB_STATE=$USB_STATE" "ADB_SECURE=$ADB_SECURE" "WIFI_STATE=$WIFI_STATE" "SECURITY_STATE=$SECURITY_STATE"
  [ -n "$SECURITY_WARNING" ] && echo "SECURITY_WARNING=$SECURITY_WARNING"
  exit 0
fi
echo "Local Termux Shell"
case "$LOCAL_ADB_STATE" in
  ready) printf '%s\n' "Status: Ready" "Runtime identity: Termux application UID $LOCAL_ADB_RUNTIME_UID" ;;
  legacy_runtime) printf '%s\n' "Status: Legacy bridge detected" "Runtime identity: Android shell UID $LOCAL_ADB_RUNTIME_UID" ;;
  *) echo "Status: Not running" ;;
esac
printf 'Loopback endpoint: %s\n' "$LOCAL_ADB_ENDPOINT"
printf 'Authentication: %s\n' "$BRIDGE_AUTH"
printf 'Listener scope: %s\n' "$LISTENER_SCOPE"
printf '%s\n' "USB debugging dependency: None" "Wireless Debugging dependency: None" "Wi-Fi dependency: None" "Android adbd dependency: None"
case "$ADBD_TCP_EXPOSURE" in none) echo "Android ADB TCP exposure: None" ;; loopback_only) echo "Android ADB TCP exposure: Loopback only" ;; *) printf 'Android ADB TCP exposure: %s\n' "$ADBD_TCP_EXPOSURE" ;; esac
[ -n "$WIFI_STATE" ] && printf 'Wi-Fi: %s\n' "$WIFI_STATE"
[ -n "$SECURITY_WARNING" ] && printf 'Security note: %s\n' "$SECURITY_WARNING"
exit 0
