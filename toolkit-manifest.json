{
  "name": "AI Termux WADB Toolkit",
  "version": "1.0.1",
  "release_date": "2026-11-02",
  "interface": {
    "human": "ai-info",
    "guided": "ai-info",
    "machine": "ai-info --json",
    "disconnect": "ai-info --disconnect",
    "command_reference": "ai-info --commands"
  },
  "features": {
    "wireless_adb": true,
    "typed_mdns_discovery": true,
    "trusted_key_first": true,
    "wadb_bridge_version": "1.5",
    "desktop_commander_mcp_docs": true,
    "mcp_local_recovery": true,
    "mcp_boot_recovery": true,
    "github_recovery_optional": true,
    "owner_label_optional": true,
    "recovery_receiver_exported": false,
    "recovery_disable_restores_termux_external_apps": true,
    "configurable_fallback_scan_range": true,
    "uninstall_script": true,
    "bridge_write_verification": true,
    "bridge_auto_finalize_after_adb": true,
    "bridge_independent_permission_grants": true,
    "bridge_required_write_path": true,
    "termux_settings_provider_fallback": false,
    "bridge_set_retries": 3,
    "bridge_readback_verification": true,
    "coloros_permission_monitoring_guidance": true,
    "bridge_signer_migration_detection": true,
    "typed_connect_before_bridge_enable": true,
    "paired_permission_setup_result": true,
    "coloros_retry_without_repair": true,
    "coloros_permission_monitoring_state_read": true,
    "coloros_first_setup_dual_toggle_guidance": true,
    "bridge_cache_version_sync": true,
    "bridge_update_post_install_verify": true,
    "installer_help_non_mutating": true,
    "uninstall_all_mode": true,
    "uninstall_keep_recovery_mode": true,
    "uninstall_dry_run": true,
    "uninstall_preserves_desktop_commander": true,
    "uninstall_preserves_termux_adb_key": true,
    "uninstall_bridge_user0_verification": true,
    "uninstall_bridge_manual_settings_fallback": true,
    "ai_info_responsive_human_output": true,
    "installer_backup_retention_count": 5,
    "pairing_pending_guard": true,
    "pairing_code_not_persisted": true,
    "pairing_second_connect_blocked": true,
    "pairing_reset_command": true,
    "pairing_state_ttl_seconds": 600,
    "github_schema_validation": true,
    "github_control_identity_baseline": true,
    "github_public_immutable_head_read": true,
    "github_public_credential_helper_disabled": true,
    "github_token_file_permission_enforcement": true,
    "github_writer_reader_account_independence_documented": true,
    "github_status_action_local_only_documented": true,
    "github_public_requires_git_curl": true,
    "mcp_recovery_state_separated": true,
    "mcp_desired_state_separate": true,
    "watchdog_restores_while_mcp_offline": true,
    "transition_notifications": true,
    "termux_api_optional_capability": true,
    "bridge_recovery_notifications": true,
    "mcp_duplicate_detection": true,
    "mcp_log_viewer": true,
    "localhost_adb_mode": true,
    "localhost_adb_default_port": 47173,
    "localhost_adb_wifi_independent_after_bootstrap": true,
    "localhost_adb_preserves_adb_enabled_on_off": true,
    "localhost_adb_listener_scope_reporting": true,
    "localhost_adb_wireless_bootstrap_fallback": true,
    "localhost_secure_shell_bridge": true,
    "localhost_bridge_default_port": 47173,
    "localhost_bridge_auth_token": true,
    "localhost_bridge_loopback_only": true,
    "classic_adbd_tcp_disabled_in_secure_mode": true,
    "wireless_adb_temporary_bootstrap": true,
    "same_phone_network_transport_guard": true,
    "wireless_debug_status_write_result_exact_match": true,
    "mcp_logout_syncs_authoritative_desired_state": true,
    "bridge_apk_cached_sha256_verification": true,
    "adb_target_multi_property_guard": true,
    "desktop_commander_fallback_pinned": "0.3.1",
    "github_generation_counter_max_digits": 18,
    "duplicate_generic_ai_instruction_copy_removed": true,
    "signed_release_manifest": true,
    "installed_file_integrity_check": true,
    "external_release_key_pin_required": true,
    "installer_symlink_component_preflight": true,
    "installer_transactional_rollback": true,
    "localhost_bridge_bounded_client_workers": true,
    "localhost_bridge_authentication_deadline_ms": 2000,
    "localhost_bridge_request_frame_deadline_ms": 10000,
    "localhost_bridge_shell_command_deadline_ms": 120000,
    "installed_integrity_permission_mode_check": true,
    "installed_integrity_independent_pin_each_run": true,
    "ai_info_disconnect_menu": true,
    "ai_info_exact_transport_disconnect": true,
    "ai_info_wireless_debug_off_confirmed": true,
    "ai_info_command_catalogue": true,
    "ai_info_reports_mcp_desired_actual_mismatch": true,
    "wireless_debug_toggle_without_active_adb_transport_after_setup": true
  },
  "github_allowed_actions": [
    "START_MCP",
    "STOP_MCP",
    "RESTART_MCP",
    "STATUS"
  ],
  "github_disallowed_actions": [
    "LOGOUT_MCP"
  ],
  "privilege": "Termux user by default; optional owner-authorized su access on rooted devices. Wireless ADB and Secure Local Shell use Android shell permissions.",
  "wadb_bridge_apk_sha256": "150755ff8f312b7764b954d7b6508f38d51d66ace5e8fe551c0328ce828c68c4",
  "wadb_bridge_certificate_sha256": "e99e14787a8e24e8b12b59f2b3d71f4a114ddcaa72d4d837e4839de87436579a",
  "release_security": {
    "signature_algorithm": "Ed25519",
    "signed_package_manifest": true,
    "strict_exact_file_inventory": true,
    "external_fingerprint_required": true,
    "signed_installed_file_inventory": true,
    "installed_integrity_checker": true,
    "github_artifact_attestation": false,
    "immutable_public_release": false,
    "sbom_complete": false,
    "license_status": "Apache-2.0",
    "same_uid_tamper_resistance": "detection_only_not_prevention",
    "public_release_approved": true,
    "installed_inventory_schema": 2,
    "installer_rollback": "snapshot_restore_on_failure_before_commit",
    "bridge_client_isolation": "bounded_forked_workers_with_deadlines",
    "installer_symlink_policy": "lstat_preflight_before_writes",
    "installer_lock": "home_level_flock",
    "installed_inventory_fields": [
      "sha256",
      "mode"
    ],
    "installed_check_trust": "external_fingerprint_required_each_run",
    "native_bridge_workers": 8,
    "native_bridge_auth_timeout_ms": 2000,
    "native_bridge_frame_timeout_ms": 10000,
    "native_bridge_response_timeout_ms": 10000,
    "native_bridge_command_timeout_ms": 120000
  },
  "license": "Apache-2.0",
